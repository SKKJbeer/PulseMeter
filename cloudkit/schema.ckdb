DEFINE SCHEMA

    RECORD TYPE CD_BillingPeriodRecord (
        CD_currencyCode STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customerReference STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_meteringPointID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_monthlyPrepaymentScaled INT64 QUERYABLE SORTABLE,
        CD_provider STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rangeEnd INT64 QUERYABLE SORTABLE,
        CD_rangeStart INT64 QUERYABLE SORTABLE,
        CD_valueScale INT64 QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MeterDeviceRecord (
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_installedOn INT64 QUERYABLE SORTABLE,
        CD_meteringPoint STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photoID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_removedOn INT64 QUERYABLE SORTABLE,
        CD_serialNumber STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MeteringPointRecord (
        CD_billingAnchorDay INT64 QUERYABLE SORTABLE,
        CD_billingAnchorMonth INT64 QUERYABLE SORTABLE,
        CD_colorToken STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customKindName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customKindUnit STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isArchived INT64 QUERYABLE SORTABLE,
        CD_kindID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_measuresHeatPump INT64 QUERYABLE SORTABLE,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_property STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_propertyID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_readingIntervalID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_symbolName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unitID STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PropertyRecord (
        CD_city STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_postalCode STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_street STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ReadingRecord (
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_day INT64 QUERYABLE SORTABLE,
        CD_deviceID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_originID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photoID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_register STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_registerID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scaledValue INT64 QUERYABLE SORTABLE,
        CD_timeMinutes INT64 QUERYABLE SORTABLE,
        CD_valueScale INT64 QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RegisterRecord (
        CD_accumulationID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_directionID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fractionDigits INT64 QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_integerDigits INT64 QUERYABLE SORTABLE,
        CD_label STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_meteringPoint STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_obisCode STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_unitID STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RentalUnitRecord (
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_occupancyData BYTES,
        CD_occupancyData_ckAsset ASSET,
        CD_property STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TariffRecord (
        CD_billingUnitID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_currencyCode STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_feedInPriceScaled INT64 QUERYABLE SORTABLE,
        CD_gasCalorificValueScaled INT64 QUERYABLE SORTABLE,
        CD_gasStateNumberScaled INT64 QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_meteringPointID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_monthlyBasePriceScaled INT64 QUERYABLE SORTABLE,
        CD_pricePerUnitScaled INT64 QUERYABLE SORTABLE,
        CD_registerID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_validFrom INT64 QUERYABLE SORTABLE,
        CD_validTo INT64 QUERYABLE SORTABLE,
        CD_valueScale INT64 QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        roles LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
